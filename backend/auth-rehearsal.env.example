# Copy outside the repository and replace every placeholder with a random,
# disposable value. Never commit the populated file.
REHEARSAL_MYSQL_DATABASE=cgfoodtour_auth_rehearsal
REHEARSAL_MYSQL_USER=cgft_auth_rehearsal
REHEARSAL_MYSQL_PASSWORD=REPLACE_WITH_RANDOM_VALUE
REHEARSAL_MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
REHEARSAL_CSRF_ORIGIN=http://localhost:5173
REHEARSAL_ADMIN_EMAIL=REPLACE_WITH_DISPOSABLE_EMAIL
REHEARSAL_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_VALUE
REHEARSAL_JWT_SIGNER_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
REHEARSAL_REGISTRATION_IP_PEPPER=REPLACE_WITH_RANDOM_VALUE
REHEARSAL_OTP_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_VALUE

# Flutter integration harness values for F1.1E.
AUTH_SPIKE_RUN_REAL=true
APP_ENV=localAndroid
API_BASE_URL=http://10.0.2.2:18081/api
CSRF_ORIGIN=http://localhost:5173
ALLOW_INSECURE_HTTP=true
AUTH_SPIKE_PHASE=full
AUTH_SPIKE_ADMIN_EMAIL=REPLACE_WITH_SAME_DISPOSABLE_ADMIN_EMAIL
AUTH_SPIKE_ADMIN_PASSWORD=REPLACE_WITH_SAME_RANDOM_ADMIN_PASSWORD
AUTH_SPIKE_USER_EMAIL=REPLACE_WITH_DISPOSABLE_USER_EMAIL
AUTH_SPIKE_USER_PASSWORD=REPLACE_WITH_RANDOM_VALUE
AUTH_SPIKE_DISABLED_ADMIN_EMAIL=REPLACE_WITH_DISPOSABLE_DISABLED_ADMIN_EMAIL
AUTH_SPIKE_DISABLED_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_VALUE
AUTH_SPIKE_REFRESH_COOKIE_NAME=cgft_refresh
AUTH_SPIKE_CSRF_COOKIE_NAME=cgft_csrf
AUTH_SPIKE_EXPECT_SECURE_COOKIES=false
AUTH_SPIKE_INVALID_ORIGIN=https://invalid-origin.example
