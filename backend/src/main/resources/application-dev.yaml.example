# Development Environment Template (Copy this to application-dev.yaml and fill in your details)
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/cgfoodtour
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  mail:
    host: smtp.gmail.com
    port: 587
    username: YOUR_GMAIL_ADDRESS@gmail.com
    password: YOUR_GMAIL_APP_PASSWORD # Mã ứng dụng Gmail gồm 16 ký tự viết liền
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000

app:
  base-url: http://localhost:8080/api
  openapi:
    dev-url: http://localhost:8080
  google:
    client-id: YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

jwt:
  signerKey: YOUR_64_CHARACTER_HEX_JWT_SIGNER_KEY_HERE
  valid-duration: 300 # in seconds
  refreshable-duration: 1200 # seconds

springdoc:
  api-docs:
    path: /api-docs
    enabled: true
  swagger-ui:
    path: /swagger-ui.html
    enabled: true
    operations-sorter: method
    tags-sorter: alpha
    try-it-out-enabled: true
    filter: true
    display-request-duration: true
  show-actuator: false

# Cloudinary Configuration
cloudinary:
  cloud-name: ${CLOUDINARY_CLOUD_NAME:YOUR_CLOUDINARY_CLOUD_NAME}
  api-key: ${CLOUDINARY_API_KEY:YOUR_CLOUDINARY_API_KEY}
  api-secret: ${CLOUDINARY_API_SECRET:YOUR_CLOUDINARY_API_SECRET}
  folder: cgfoodtour/avatars
  default-avatar-url: https://res.cloudinary.com/demo/image/upload/v1620000000/sample.jpg

# Development Logging Configuration
logging:
  level:
    root: INFO
    com.cangiuoc.cgfoodtour: DEBUG
    org.springframework.web: INFO
    org.hibernate.SQL: DEBUG
    org.hibernate.type.descriptor.sql.BasicBinder: TRACE
