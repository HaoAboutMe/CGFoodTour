# ===================================================================
# Backend Production Environment Variables Template
# Copy this file to .env.prod on the server / deployment environment
# DO NOT commit real secrets or .env.prod to Git!
# ===================================================================

# Active Profile
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
SPRING_DATASOURCE_URL=jdbc:mysql://cgt-db:3306/cgfoodtour?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=cg_app_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MIN_IDLE=2
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Configuration (HS512 requires minimum 64-character / 512-bit hex key)
# Generate with: openssl rand -hex 32
JWT_SIGNER_KEY=CHANGE_ME_64_CHARACTER_HEX_KEY_EXAMPLE_0123456789abcdef0123456789abcdef
JWT_VALID_DURATION=1800
JWT_REFRESHABLE_DURATION=2592000
OTP_PEPPER=CHANGE_ME_DEDICATED_OTP_SECRET
REGISTRATION_IP_PEPPER=CHANGE_ME_DEDICATED_REGISTRATION_IP_SECRET

# Administrator Credentials Initialization (Phase 0 Security Improvement)
APP_ADMIN_DEFAULT_EMAIL=admin@cangiuocfoodtour.vn
APP_ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Base URLs & CORS Whitelist
APP_BASE_URL=https://yourdomain.com/api
APP_OPENAPI_DEV_URL=https://yourdomain.com
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Mail Service (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-16-char-app-password

# OAuth Services (Google & Facebook)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=cgfoodtour/avatars
CLOUDINARY_DEFAULT_AVATAR_URL=https://res.cloudinary.com/dmeazyjkz/image/upload/v1787030590/avatar-default_i3mwpi.svg

# Reverse proxy. Enable only when requests reach the app exclusively through the
# listed proxy network; never trust arbitrary client-supplied forwarding headers.
TRUST_FORWARDED_HEADERS=true
TRUSTED_PROXY_CIDRS=172.20.0.0/16
MAXIMUM_FORWARDED_HOPS=1

# Operational guardrails
SSE_MAX_CONNECTIONS=200
SSE_HEARTBEAT_DELAY_MS=30000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_INITIAL_DELAY_MS=500
