# Public values embedded into the frontend production bundle at build time.
# Never place Google/Facebook client secrets in a VITE_* variable.

# Same-origin deployments always use /api. This can also be omitted because
# production source code enforces /api independently from local .env files.
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=example-client.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=example-facebook-app-id
