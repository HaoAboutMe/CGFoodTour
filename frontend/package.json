{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run verify:build",
    "verify:build": "node scripts/verify-production-build.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "lint": "oxlint --deny-warnings",
    "test": "node --test src/utils/*.test.js src/components/**/*.test.mjs scripts/*.test.mjs",
    "test:primitives": "node --test src/components/ui/primitives.test.mjs",
    "test:modal": "node --test src/components/modals/ConfirmActionModal.test.mjs",
    "test:redaction": "node --test src/utils/redactSensitiveData.test.js",
    "test:ui-errors": "node --test src/utils/apiErrorMessages.test.js",
    "test:maps": "node --test src/utils/googleMapsUrl.test.js",
    "test:store-url": "node --test src/utils/storeUrl.test.js",
    "test:modal-validation": "node --test src/utils/destructiveAction.test.js",
    "test:tokens": "node --test src/utils/designTokens.test.js",
    "test:build-contract": "node --test scripts/frontend-build-contract.test.mjs",
    "test:nginx-contract": "node --test scripts/nginx-contract.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.4"
  }
}
