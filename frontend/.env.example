# Frontend Environment Variables Template
# Copy this file to .env.development and fill in your local values.
# Do not reuse the development file for a production build.

# API Base URL (default is http://localhost:8080/api for dev, /api for prod behind reverse proxy)
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Facebook App ID
VITE_FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
